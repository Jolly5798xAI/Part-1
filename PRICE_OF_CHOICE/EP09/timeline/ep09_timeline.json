 "subtitles": [
  [
   0.0,
   1.7,
   "За дверью звучал *мой голос*,"
  ],
  [
   2.18,
   4.54,
   "тот самый, с которого !всё началось!."
  ],
  [
   5.38,
   7.6,
   "Настоящий Алекс схватил меня *за плечо*."
  ],
  [
   7.82,
   8.4,
   "«!Прячься¡!»"
  ],
  [
   8.58,
   9.72,
   "«Он не должен *нас увидеть*»."
  ],
  [
   10.36,
   12.26,
   "Я спрятался за *кухонной стеной*."
  ],
  [
   12.58,
   13.52,
   "Замок *щёлкнул*."
  ],
  [
   13.86,
   16.28,
   "В квартиру вошёл !ещё один я!."
  ],
  [
   16.72,
   18.3,
   "В руке он держал *стакан воды*."
  ],
  [
   18.88,
   20.96,
   "Но самое страшное было не это."
  ],
  [
   21.2,
   25.2,
   "На его запястье светился номер !сорок девять!."
  ],
  [
   25.64,
   28.55,
   "Я посмотрел на свою руку: *сорок восемь*."
  ],
  [
   28.62,
   30.24,
   "«*Почему он следующий?*»"
  ],
  [
   30.82,
   32.18,
   "Настоящий Алекс прошептал:"
  ],
  [
   32.6,
   34.66,
   "«Потому что тебя !уже списали!»."
  ],
  [
   35.28,
   37.56,
   "Вдруг телефон нового Алекса *завибрировал*."
  ],
  [
   37.96,
   39.02,
   "«!Задание выполнено!»."
  ],
  [
   39.34,
   41.48,
   "«!Уничтожить предыдущую копию!»."
  ],
  [
   42.08,
   45.18,
   "Он медленно повернул голову — *прямо в мою сторону*."
  ],
  [
   45.48,
   46.28,
   "Я *отступил*."
  ],
  [
   46.52,
   49.1,
   "Но настоящий Алекс схватил со стола !нож!."
  ],
  [
   49.54,
   51.96,
   "Тот самый, который я видел *на записи*."
  ],
  [
   52.36,
   55.0,
   "Я понял: !будущее начинало сбываться!."
  ],
  [
   55.44,
   57.86,
   "Но вместо меня он ударил ножом *по телефону*."
  ],
  [
   58.08,
   59.14,
   "Экран *раскололся*."
  ],
  [
   59.5,
   61.98,
   "Все трое одновременно услышали *голос сестры*."
  ],
  [
   62.32,
   64.4,
   "«Алекс, !не верь оригиналу¡!»"
  ],
  [
   64.82,
   65.88,
   "Настоящий Алекс *замер*."
  ],
  [
   66.16,
   67.26,
   "Его лицо *изменилось*."
  ],
  [
   67.7,
   71.62,
   "И вдруг на его запястье загорелся номер: !ноль!."
  ],
  [
   71.96,
   73.06,
   "Он посмотрел на меня."
  ],
  [
   73.7,
   76.56,
   "«Теперь ты понимаешь, почему я *не могу выйти отсюда*?»"
  ],
  [
   77.22,
   78.36,
   "Я хотел ответить,"
  ],
  [
   78.46,
   80.24,
   "но входная дверь *снова открылась*."
  ],
  [
   80.42,
   82.9,
   "На пороге стоял полицейский. !Без маски!."
  ],
  [
   83.22,
   85.58,
   "Под маской всё это время был *я*,"
  ],
  [
   85.96,
   87.18,
   "только !намного старше!."
  ],
  [
   87.44,
   88.3,
   "Он *поднял телефон*."
  ],
  [
   88.74,
   90.32,
   "На экране появилось сообщение:"
  ],
  [
   90.68,
   91.96,
   "«!Создатель обнаружен!»."
  ],
  [
   92.1,
   93.76,
   "«!Начать последнюю проверку!»."
  ],
  [
   94.06,
   96.02,
   "«!Оригинал должен умереть!»."
  ]
 ],
