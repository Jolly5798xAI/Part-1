  ],
  [
   23.64,
   26.0,
   "На экранах появились !сотни лиц!."
  ],
  [
   26.21,
   27.7,
   "Каждое было *моим*."
  ],
  [
   28.05,
   29.3,
   "«*Что это такое?*»"
  ],
  [
   29.59,
   31.3,
   "«Те, кто !не прошёл испытания!», —"
  ],
  [
   31.4,
   32.75,
   "ответил полицейский."
  ],
  [
   32.9,
   35.5,
   "Я посмотрел на свою *исчезающую руку*."
  ],
  [
   35.7,
   38.6,
   "«А деньги? Задания? *Стакан воды?*»"
  ],
  [
   39.07,
   40.6,
   "Алекс-ноль произнёс:"
  ],
  [
   40.88,
   43.95,
   "«Мы проверяли, способен ли ты *отказаться*."
  ],
  [
   44.18,
   46.3,
   "Каждый раз ты выбирал !награду!»."
  ],
  [
   46.7,
   49.15,
   "Я вспомнил, как поставил *стакан у двери*"
  ],
  [
   49.31,
   51.6,
   "и как получил *пятьсот долларов*."
  ],
  [
   51.91,
   54.1,
   "«Но я *не знал*, что происходит»."
  ],
  [
   54.64,
   55.6,
   "«*Теперь знаешь*», —"
  ],
  [
   55.74,
   56.7,
   "ответил он."
  ],
  [
   56.89,
   58.7,
   "Полицейский протянул мне *телефон*."
  ],
  [
   58.76,
   60.5,
   "На экране было *два варианта*:"
  ],
  [
   60.64,
   62.0,
   "«!Уничтожить оригинал!»,"
  ],
  [
   62.15,
   63.6,
   "«*Остановить игру*»."
  ],
  [
   63.98,
   65.8,
   "Я нажал «*Остановить игру*»,"
  ],
  [
   65.91,
   67.35,
