  ],
  [
   12.8,
   14.9,
   "«Потому что он !создал нас!»."
  ],
  [
   15.59,
   17.75,
   "Алекс-ноль медленно *поднял голову*."
  ],
  [
   18.05,
   19.55,
   "«Я *создал игру*."
  ],
  [
   19.68,
   21.1,
