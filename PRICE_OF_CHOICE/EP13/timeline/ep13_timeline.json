 "subtitles": [
  [
   0.16,
   2.6,
   "Обе Елены *одновременно* сказали:"
  ],
  [
   2.77,
   3.95,
   "«!Не верь мне!»."
  ],
  [
   4.57,
   6.85,
   "Я смотрел то на сестру, то на монитор."
  ],
  [
   6.98,
   8.6,
   "«Которая из вас *настоящая?*»"
  ],
  [
   8.72,
   10.7,
   "Елена рядом со мной *подняла руку*."
  ],
  [
   10.84,
   13.7,
   "На запястье светился *номер один*."
  ],
  [
   13.81,
   15.95,
   "На экране у *второй Елены*"
  ],
  [
   16.06,
   17.45,
   "появился !ноль!."
  ],
  [
   17.61,
   19.7,
   "«Я *настоящая*», — сказала она, —"
  ],
  [
   19.83,
   22.3,
   "«а та, что рядом, !создана системой!»."
  ],
  [
   22.46,
   23.35,
   "Я отступил."
  ],
  [
   23.46,
   25.95,
   "Но Елена с номером один *схватила меня*."
  ],
  [
   26.08,
   28.4,
   "«!Она врёт!. Проверь *запись аварии*»."
  ],
  [
   28.68,
   30.5,
   "Я открыл *панель администратора*."
  ],
  [
   30.62,
   32.8,
   "На экране появилась *скрытая запись*."
  ],
  [
   32.96,
   34.05,
   "*Ночная дорога*."
  ],
  [
   34.17,
   35.55,
   "Телефон с заданием."
  ],
  [
   35.67,
   39.4,
   "И ещё один человек на *заднем сиденье*."
  ],
  [
   39.74,
   42.3,
   "Это был… !настоящий Алекс!."
  ],
  [
   42.45,
   43.95,
   "Он держал *второй телефон*."
  ],
  [
   44.04,
   45.65,
   "На нём светилась команда:"
  ],
  [
   45.75,
   47.2,
   "«!Отключить тормоза!»."
  ],
  [
   47.35,
   48.15,
   "Я *замер*."
  ],
  [
   48.32,
   49.95,
   "«Ты сам *устроил аварию?*»"
  ],
  [
   50.12,
   52.0,
   "Оригинал на мониторе *улыбнулся*."
  ],
  [
   52.14,
   54.2,
   "«Мне нужен был !идеальный выбор!»."
  ],
  [
   54.38,
   56.45,
   "Елена с номером один прошептала:"
  ],
  [
   56.63,
   59.15,
   "«Он проверял, кто *пожертвует собой*»."
  ],
  [
   59.29,
   61.6,
   "Вдруг система выдала *предупреждение*:"
  ],
  [
   61.72,
   63.75,
   "«!Обнаружена последняя копия!."
  ],
  [
   63.87,
   65.45,
