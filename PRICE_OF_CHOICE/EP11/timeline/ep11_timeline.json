 "subtitles": [
  [
   0.13,
   2.8,
   "«Следующий игрок: !Елена!»."
  ],
  [
   3.06,
   4.85,
   "И сразу её !крик!."
  ],
  [
   5.23,
   7.6,
   "Я бросился к двери *комнаты двести четыре*,"
  ],
  [
   7.78,
   9.65,
   "но полицейский *схватил меня*."
  ],
  [
   9.82,
   10.8,
   "«*Не входи*."
  ],
  [
   10.87,
   12.95,
   "Там начинается !нулевой уровень!»."
  ],
  [
   13.19,
   14.9,
   "Я вырвался и *открыл дверь*."
  ],
  [
   15.04,
   16.95,
   "За ней стояла *моя сестра*,"
  ],
  [
   17.01,
   18.38,
   "!прикованная к креслу!."
  ],
  [
   18.43,
   20.1,
   "Перед ней горел *экран*."
  ],
  [
   20.39,
   22.25,
   "«*Выберите, кого сохранить*»."
  ],
  [
   22.42,
   24.75,
   "«!Создателя! или *игрока*»."
  ],
  [
   24.98,
   26.8,
   "Елена посмотрела на меня."
  ],
  [
   27.05,
   27.8,
   "«*Алекс*."
  ],
  [
   27.89,
   30.05,
   "Я !не создавала! эту игру»."
  ],
  [
   30.29,
   32.5,
   "«Но на экране было *твоё имя*»."
  ],
  [
   33.09,
   34.98,
   "«Я создала *только копии*,"
  ],
  [
   35.07,
   36.55,
   "чтобы !спасти тебя!»."
  ],
  [
   36.78,
   38.15,
   "Она указала на *монитор*."
  ],
  [
   38.27,
   40.95,
   "На записи я лежал в *больничной палате*"
  ],
  [
   41.04,
   42.8,
   "!без сознания!."
  ],
  [
   42.95,
   45.35,
   "«Ты попал в аварию *три года назад*."
  ],
  [
   45.6,
   47.95,
   "Я пыталась вернуть *твою память*."
  ],
  [
   48.13,
   52.6,
   "Но программа начала создавать !новые версии тебя!»."
  ],
  [
   52.84,
   55.7,
   "Я посмотрел на свою *исчезающую руку*."
  ],
  [
   55.99,
   59.25,
   "«Значит, *настоящий Алекс* всё ещё жив?»"
  ],
  [
   59.59,
   60.9,
   "Елена *кивнула*."
  ],
  [
   61.04,
   63.0,
   "Вдруг экран загорелся !красным!."
  ],
  [
   63.17,
   65.5,
   "«!Нулевой уровень! активирован»."
  ],
  [
   65.75,
   67.8,
   "«!Удаление всех копий!»."
  ],
  [
   68.01,
   70.5,
   "Полицейский за моей спиной начал *рассыпаться*."
  ],
  [
   70.56,
   72.2,
   "Из коридора донёсся *крик*."
  ],
  [
   72.32,
   74.9,
   "Алекс-сорок девять тоже !исчезал!."
  ],
  [
   75.12,
   76.6,
   "Я бросился *к компьютеру*,"
  ],
  [
   76.66,
   78.15,
   "но Елена закричала:"
  ],
  [
   78.28,
   79.7,
   "«!Не трогай его¡!»"
  ],
  [
   79.89,
   81.05,
   "«*Почему?*»"
  ],
  [
   81.31,
   84.1,
   "«Потому что это !не компьютер!»."
  ],
  [
   84.34,
   86.3,
   "Экран медленно *повернулся*."
  ],
  [
   86.42,
   88.3,
   "На нём появилось *моё лицо*,"
  ],
  [
   88.4,
   90.55,
   "только с *закрытыми глазами*."
  ],
  [
   90.75,
   92.35,
   "А потом глаза !открылись!."
  ],
  [
   92.48,
   95.4,
   "Я услышал *собственный голос*:"
  ],
  [
   95.69,
   97.85,
   "«Елена, *отойди от него*."
  ],
  [
   98.0,
   101.3,
   "Эта копия уже !знает слишком много!»."
  ],
  [
